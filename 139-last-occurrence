public static Integer findLast(List<Integer> nums, Integer target) {
     if(nums == null || target == null || nums.isEmpty()){
           return -1;

       }
   Integer ultimoIndice = -1;
   for( Integer i = 0; i< nums.size(); i++){
      if(nums[i] == target){
          ultimoIndice = i;
      }
      
   }
   return ultimoIndice;

   
}