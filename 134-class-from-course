public Id classFromCourse(String courseName) {
    list<apxio__Course__c> cursos = [select id, name from apxio__Course__c where name = :courseName limit 1];

    if(cursos.isEmpty()){
        return null;
    }

    apxio__Class__c nuevaClase = new apxio__Class__c();

    nuevaClase.name = courseName;
    nuevaClase.apxio__Course__c = cursos[0].id;
    insert nuevaClase;
    return nuevaClase.id;




}