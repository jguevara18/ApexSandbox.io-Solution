public Integer findTargetCount(List<Integer> nums, Integer target) {
    if (nums == null || nums.isEmpty() || target == null){
        return 0;
    }
    Integer count = 0;
    for( Integer num : nums){
        if(num == target){
            count++;    
    
    }
    return count > 1 ? count - 1 : 0;

}
}