public void createCourseAndClass(String name, String description) {
    apxio__Course__c crearCurso = new apxio__Course__c();
    crearCurso.name = name;
    crearCurso.apxio__Course_Details__c = description;

    insert crearCurso;

    string descripRecortada = (description != null) ? description.left(255): null;


    apxio__Class__c crearClase = new apxio__Class__c();
    crearClase.name = name;
    crearClase.apxio__Description__c = descripRecortada;
    crearClase.apxio__Course__c = crearCurso.id;
    insert crearClase;
    
}