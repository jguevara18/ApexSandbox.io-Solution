public List<sObject> getListOfsObject(List<Account> accounts, List<Contact> contacts)
{
    list<sObject> nuevaLista = new list<sObject>();
    if(accounts !=null){
      nuevaLista.addall(accounts);  
    }
    if(contacts !=null){
      nuevaLista.addall(contacts);  
    }
    
    return nuevaLista;
}