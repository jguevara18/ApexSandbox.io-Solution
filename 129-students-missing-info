public List<apxio__Student__c> selectStudentsWithoutContactInfo() {
    return [id, name from apxio__Student__c where (apxio__Active__c = true and  (apxio__Email__c = null or  apxio__Phone__c = null)) or (apxio__Active__c =true and apxio__Phone__c = null and apxio__Email__c = null  ) order by name asc ];
}