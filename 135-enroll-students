    apxio__Class__c targetClass = [select id from apxio__Class__c where name = :className limit 1];
    list<apxio__Student__c>  estudiantes = [select id, apxio__Email__c from apxio__Student__c where apxio__Email__c in :emails];

    for (apxio__Student__c est : estudiantes){
       apxio__Class_Enrollment__c enrollment = new apxio__Class_Enrollment__c();

