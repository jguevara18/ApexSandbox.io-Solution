public List<Account> getAccounts(List<Account> accounts) {
   if (accounts == null || accounts.isEmpty()) {
        return new List<Account>();
    }

    // 1. Crear una lista de la clase contenedora (Wrapper)
    List<AccountWrapper> wrappers = new List<AccountWrapper>();
    for (Account acc : accounts) {
        wrappers.add(new AccountWrapper(acc));
    }

    // 2. Ordenar la lista de wrappers usando el método .sort()
    wrappers.sort();

    // 3. Extraer las cuentas ya ordenadas
    List<Account> sortedAccounts = new List<Account>();
    for (AccountWrapper wrap : wrappers) {
        sortedAccounts.add(wrap.acc);
    }

    return sortedAccounts;
}
public class AccountWrapper implements Comparable {
    public Account acc;

    public AccountWrapper(Account acc) {
        this.acc = acc;
    }

    public Integer compareTo(Object compareTo) {
        AccountWrapper otherWrapper = (AccountWrapper) compareTo;

        Decimal currentRevenue = this.acc.AnnualRevenue != null ? this.acc.AnnualRevenue : 0;
        Decimal otherRevenue = otherWrapper.acc.AnnualRevenue != null ? otherWrapper.acc.AnnualRevenue : 0;

        // Para orden DESCENDENTE:
        // Si el valor actual es MENOR que el otro, va DESPUÉS (retorna 1).
        // Si el valor actual es MAYOR que el otro, va ANTES (retorna -1).
        if (currentRevenue < otherRevenue) {
            return 1;
        } else if (currentRevenue > otherRevenue) {
            return -1;
        }
        return 0;
    }
}
